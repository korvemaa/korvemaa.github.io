---
type Entry = { name: string; url: string };

type Props = {
    name: string;
    url: string;
};

const { name, url } = Astro.props;

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.replace(/\/$/, "");

const resolve = (target: string) => {
    if (/^https?:\/\//.test(target)) return target;
    const path = target.startsWith("/") ? target : `${base}/${target}`;
    return path.replace(/\/{2,}/g, "/");
};

const isActive = (target: string) =>
    resolve(target).replace(/\/$/, "") === pathname;
---

<li>
    <a href={resolve(url)} class:list={["file", { active: isActive(url) }]}>
        <i class="bi bi-file-earmark"></i>
        <span>{name}</span>
    </a>
</li>

<style>
    li {
        list-style: none;
    }

    ul {
        list-style: none;
        margin: 0;
        padding-left: 1rem;
    }

    a.file {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.25rem;
        text-decoration: none;
        user-select: none;
    }

    a.file:hover {
        background-color: var(--dimmed-glow-color);
    }

    a.file.active {
        background-color: var(--dimmed-glow-color);
    }

    i {
        font-size: 0.85em;
    }
</style>
