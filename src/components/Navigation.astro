---
import ExplorerFolder from "@component/ExplorerFolder.astro";
import ScrollView from "@component/ScrollView.astro";

let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
if (pathname == "") pathname = "index";

const pages = Object.values(
	import.meta.glob("/src/pages/**/*.astro", { eager: true }),
);

const explorer = pages
	.filter((page: any) => page.explorer)
	.map((page: any) => ({
		name: page.explorer.name,
		folder: page.explorer.folder,
		order: page.explorer.order,
		url: page.url || "/",
		children: page.explorer.children,
	}))
	.sort((a, b) => a.order - b.order);

const rootFolder = `korvemaa.dev`;
---

<ScrollView>
<nav id="navigation">
	<ExplorerFolder name={rootFolder} items={explorer}/>
</nav>
</ScrollView>

<style>
	nav {
		display: flex;
		flex-direction: column;
		align-items: stretch;

		flex-grow: 1;
		flex-shrink: 0;
		margin: 1rem;
		margin-bottom: 0;
		padding-bottom: 0.5rem;
		border-bottom: var(--border-width) dotted var(--dimmed-glow-color);

		min-width: 220px;
	}

	nav section {
		display: flex;
		flex-direction: row;
		background: var(--box-fade);
		border: var(--border-width) dotted var(--dimmed-glow-color);
	}

	nav a {
		display: flex;
		text-decoration: none;
		user-select: none;
	}

	nav a:hover {
		background-color: var(--dimmed-glow-color);
	}

	nav a.active {
		background-color: var(--dimmed-glow-color);
		text-decoration: none;
	}
</style>
