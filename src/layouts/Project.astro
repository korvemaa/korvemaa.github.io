---
import { getImage } from "astro:assets";
import { type CollectionEntry, render, getEntry } from "astro:content";
import Layout from "@layout/Layout.astro";
import ScrollView from "@component/ScrollView.astro";
import OpenGraphImage from "@component/OpenGraphImage.astro";
import DynamicLink from "@component/DynamicLink.astro";
import { timeAgo } from "@src/utility";

type Props = {
    post: CollectionEntry<"project">;
};
const { post } = Astro.props;
const { Content } = await render(post);

const icon = post.data.thumbnail
    ? await getImage({ src: post.data.thumbnail, width: 256 })
    : null;

const thumbnails = await Promise.all(
    (post.data.gallery || []).map((src) => getImage({ src, width: 430 })),
);

const images = await Promise.all(
    (post.data.gallery || []).map((src) => getImage({ src })),
);

const videos = post.data.videos;
const hasArticle = (post.body || "").length > 0;

const routes: { name: string; href: string }[] = [];

if (post.data.job) {
    const job = await getEntry("experience", post.data.job);
    if (job) routes.push({ href: job.data.projects, name: job.data.name });
}

routes.push({ href: "", name: post.data.title });
---

<Layout
    title={post.data.title}
    description={post.data.description}
    routes={routes}
>
    <OpenGraphImage slot="head" image={icon} />
    {
        post.data.tags && (
            <meta
                slot="head"
                property="keywords"
                content={post.data.tags.join(", ")}
            />
        )
    }

    <ScrollView style="scroll-behavior:smooth;">
        <header>
            <nav>
                <section id="thumbnail">
                    <div
                        style={`background-image: url('${icon?.src}')`}
                        id="image"
                    >
                    </div>
                </section>
                <section id="about">
                    <h1>{post.data.title}</h1>
                    <hr />
                    <p>{post.data.description}</p>
                    {
                        post.data.tags && (
                            <div class="tags">
                                {post.data.tags.sort().map((tag) => (
                                    <code>{tag}</code>
                                ))}
                            </div>
                        )
                    }
                    {
                        post.data.date && (
                            <span class="age">{timeAgo(post.data.date)}</span>
                        )
                    }
                </section>
                {
                    post.data.links && (
                        <section id="links">
                            {post.data.links.map((e) => (
                                <DynamicLink href={e} />
                            ))}
                        </section>
                    )
                }
            </nav>
            <section id="gallery">
                <div id="viewport">
                    <!-- Script will add shit here -->
                </div>
                <ul>
                    {
                        videos &&
                            videos.map((video) => (
                                <li class="item">
                                    <div
                                        style={`background-image: url("https://img.youtube.com/vi/${video}/sddefault.jpg")`}
                                        id="image"
                                    >
                                        <div
                                            id="image"
                                            style={`background-image: url("/video_overlay.png")`}
                                        />
                                    </div>

                                    {/* <iframe
                                        class="youtube-video"
                                        src={`https://www.youtube.com/embed/${video}`}
                                        allowfullscreen
                                    /> */}
                                </li>
                            ))
                    }
                    {
                        thumbnails &&
                            thumbnails.map((img) => (
                                <li class="item">
                                    <div
                                        style={`background-image: url('${img?.src}')`}
                                        id="image"
                                    />
                                </li>
                            ))
                    }
                </ul>
            </section>
        </header>
        {
            hasArticle && (
                <article>
                    <hr />
                    <Content />
                </article>
            )
        }
    </ScrollView>
</Layout>

<style>
    :root {
    }

    header {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        padding: 2rem;
    }

    header > nav {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex-shrink: 0;

        max-width: 270px;
        min-width: 270px;

        border: var(--border-width) dotted var(--dimmed-glow-color);
    }

    header > nav section {
        margin: 0 1rem;
    }

    header > nav section:last-child {
        margin-bottom: 1rem;
    }

    header section#about {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex-grow: 1;

        margin-top: -16px;
    }

    header section#about p {
        flex-grow: 1;
    }

    header section#about .tags {
        display: flex;
        flex-direction: row;
        font-size: 12px;
        gap: 4px;
    }

    header section#about .age {
        opacity: 0.5;
    }

    header section#thumbnail {
        display: flex;
        aspect-ratio: 1;
        margin: 0;

        mask-image: linear-gradient(to bottom, black 60%, transparent 95%);
    }

    header section#thumbnail #image {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        background-position: center;
        background-size: cover;
    }

    header section#links {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    header section#gallery {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1 1 auto;
        gap: 0.5rem;

        border: var(--border-width) dotted var(--dimmed-glow-color);
    }

    header section#gallery > #viewport {
        display: flex;
        flex-grow: 1;
        aspect-ratio: 16 / 9;
    }

    header section#gallery ul {
        display: flex;
        flex-direction: row;
        gap: 0.5rem;

        margin: 0;
        padding: 0;
        padding-bottom: 0.5rem;

        height: 100px;
        box-sizing: border-box;

        list-style: none;
        overflow-x: scroll;

        scroll-snap-type: x mandatory;
    }

    header section#gallery ul .item {
        display: flex;
        scroll-snap-align: center;
        flex-shrink: 0;
        overflow: hidden;

        height: 100%;
        aspect-ratio: 16/9;

        position: relative;

        cursor: pointer;
    }

    header section#gallery ul .item #image {
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        background-position: center;
        background-size: cover;
        aspect-ratio: 16/9;
    }

    header section#gallery ul .item iframe {
        display: inline-flex;
        flex-grow: 1;
        width: 100%;
        height: 100%;
        border: 0;
    }

    article {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        padding: 2rem;
        padding-top: 0;
    }
</style>
