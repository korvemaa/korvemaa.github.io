---
import Effects from "@component/Effects.astro";
import BaseHead from "@component/BaseHead.astro";
import StatusLine from "@component/StatusLine.astro";
import { SITE_DESCRIPTION } from "../consts";

const { title, description, namespace, mode } = Astro.props;

var url = Astro.originPathname;
if (url.endsWith("/")) url = url.substring(0, url.length - 1);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={title}
            description={description || SITE_DESCRIPTION}
            namespace={namespace}
        >
            <slot name="head" />
        </BaseHead>
    </head>
    <body>
        <Effects />
        <div class="website">
            <div class="top-section">
                <span> <i>KORVEMAA INDUSTRIES(TM)</i> TERMINAL </span>
                <span style="margin-left: auto;" id="current-time">9:50PM</span>
            </div>
            <div class="content">
                <main class="box" id="page">
                    <slot />
                    <StatusLine>
                        {mode && <span id="status-mode">{mode}</span>}
                        <span id="status-file">Unsaved</span>
                        <div style="margin: auto;"></div>
                        <span id="status-progress">98%</span>
                    </StatusLine>
                </main>
            </div>
        </div>
    </body>
</html>

<script defer>
    function updateClock() {
        document.getElementById("current-time").textContent =
            "SYD " +
            new Date().toLocaleTimeString("en", {
                timeZone: "Australia/Sydney",
                timeStyle: "short",
            });

        setTimeout(updateClock, 10000);
    }

    updateClock();
</script>

<script defer>
    function updateStatusFile() {
        const active = document.querySelector("#navigation a.file.active span");
        const statusFile = document.getElementById("status-file");
        if (statusFile && active) {
            statusFile.textContent = active.textContent;
        }
    }

    updateStatusFile();
    document.addEventListener("astro:page-load", updateStatusFile);
</script>

<script defer>
    function initStatusProgress() {
        const statusProgress = document.getElementById("status-progress");
        const scroller =
            document.querySelector("#page #scroll-view") || document.body;

        if (!statusProgress || !scroller) return;

        function updateProgress() {
            const max = scroller.scrollHeight - scroller.clientHeight;

            if (max <= 0) {
                statusProgress.textContent = "All";
                return;
            }

            const ratio = scroller.scrollTop / max;

            if (ratio <= 0) statusProgress.textContent = "0%";
            else if (ratio >= 0.98) statusProgress.textContent = "100%";
            else statusProgress.textContent = Math.round(ratio * 100) + "%";
        }

        scroller.addEventListener("scroll", updateProgress, { passive: true });
        window.addEventListener("resize", updateProgress, { passive: true });

        // Recalculate once content size settles (images/fonts loading, etc.)
        if (window.ResizeObserver) {
            const ro = new ResizeObserver(updateProgress);
            ro.observe(scroller);
            for (const child of scroller.children) ro.observe(child);
        }
        window.addEventListener("load", updateProgress);

        updateProgress();
    }

    initStatusProgress();
    document.addEventListener("astro:page-load", initStatusProgress);
</script>

<script defer>
    class TextScramble {
        constructor(el) {
            this.el = el;
            this.chars = "!<>-_\\/[]{}—=+*^?#________";

            this.finalText = el.textContent;
            this.el.textContent = this.randomString(this.finalText);
        }

        scramble() {
            const length = this.finalText.length;

            this.queue = [];

            for (let i = 0; i < length; i++) {
                const to = this.finalText[i];

                if (/\s/.test(to)) {
                    this.queue.push({ to, start: 0, end: 0, char: to });
                    continue;
                }

                const start = Math.floor(Math.random() * 20);
                const end = start + Math.floor(Math.random() * 20);

                this.queue.push({ to, start, end, char: this.randomChar() });
            }

            cancelAnimationFrame(this.frameRequest);
            this.frame = 0;
            this.update();
        }

        update() {
            let output = "";
            let complete = 0;

            for (let i = 0; i < this.queue.length; i++) {
                let { to, start, end, char } = this.queue[i];

                if (this.frame >= end) {
                    complete++;
                    output += to;
                } else {
                    if (this.frame >= start && Math.random() < 0.3) {
                        char = this.randomChar();
                        this.queue[i].char = char;
                    }
                    output += char;
                }
            }

            this.el.textContent = output;

            if (complete === this.queue.length) {
                this.el.textContent = this.finalText;
            } else {
                this.frameRequest = requestAnimationFrame(() => this.update());
                this.frame++;
            }
        }

        randomChar() {
            return this.chars[Math.floor(Math.random() * this.chars.length)];
        }

        randomString(text) {
            let result = "";
            for (let i = 0; i < text.length; i++) {
                result += /\s/.test(text[i]) ? text[i] : this.randomChar();
            }
            return result;
        }
    }

    window.addEventListener("DOMContentLoaded", () => {
        const instances = [];

        document.querySelectorAll(".scramble, h1").forEach((el) => {
            instances.push(new TextScramble(el));
        });

        instances.forEach((fx, i) => {
            setTimeout(() => {
                fx.scramble();
            }, i * 120);
        });
    });
</script>

<style>
    html,
    body {
        height: 100%;
        margin: 0;
        padding: 0;

        display: flex;

        /* Prevent crappy overscroll on iOS */
        overscroll-behavior: none;
        -webkit-user-drag: none;
    }

    html {
    }

    body {
        flex-direction: column;
        align-items: stretch;
        overflow: auto;
        flex-grow: 1;

        min-width: 0;
        max-width: var(--max-width);
    }

    .website {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        margin: 1rem;
        align-items: stretch;
        justify-content: center;
        gap: 0.5rem;
    }

    .content {
        display: flex;
        flex-direction: row;
        flex: 1 1 auto;
        min-height: 0;
        align-items: stretch;
        justify-content: center;
        gap: 0.5rem;
    }

    .top-section {
        display: flex;
        flex-direction: row;
        gap: 1rem;
    }

    main {
        position: relative;

        box-sizing: border-box;
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        align-items: stretch;

        image-rendering: pixelated;

        overflow: hidden;

        background-color: rgba(0, 0, 0, 0.1);
    }

    @media (max-width: 550px) {
        .website {
            margin: 0;
        }

        main {
            border: 0;
        }

        .height-restrict {
            min-height: 100%;
            max-height: unset;
        }

        .top-section {
            display: none;
        }
    }
</style>
