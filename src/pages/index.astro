<script defer>
	const align = function () {
		document.body.style.setProperty(
				"--hero-height",
				document.getElementById("scroll-view").clientHeight - 64 + "px",
			);
	};

	window.addEventListener("resize", align);
	align();
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		margin: 1rem;
		gap: 1rem;
	}

	.hero {
		display: flex;
		flex-direction: column;
		min-height: var(--hero-height);
		max-height: var(--hero-height);

		position: relative;
		overflow: hidden;
		align-items: center;
		justify-content: center;
		padding: 1rem 3rem;
	}
	
	section {
		display: flex;
		flex-direction: column;
		min-height: var(--hero-height);
		padding: 1rem;
		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

	.hero-content {
		display: grid;
		grid-template-columns: 1fr 1fr;

		align-items: center;
		justify-content: center;
		flex-direction: row;
	}

	.hero-left {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		padding-right: 2rem;
		border-right: var(--border-width) dotted var(--dimmed-glow-color);
	}

	.hero-right {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1rem;
		justify-content: center;
		padding-left: 2rem;
	}

	.hero-right #cta {
		text-decoration: none;
	}

	.hero-right #cta:hover {
		text-decoration: underline;
	}

	.hero #name-ascii {
		display: flex;
		flex-wrap: wrap;
		flex-direction: row;
		gap: 1rem;
	}

	.hero #ascii-background {
		position: absolute;
		opacity: 0.075;
		mask-image: linear-gradient(black 20%, transparent 80%);
		font-family: Terminus;
		font-size: 18px;
		pointer-events: none;
		user-select: none;
	}

	.technical {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.technical code {
		font-size: 12px;
	}

	.socials {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.socials a {
		padding: 0.5rem 1rem;
		border: var(--border-width) dotted var(--dimmed-glow-color);
		display: flex;
		flex-grow: 1;
		justify-content: center;
		text-decoration: none;
		align-items: center;
		background: var(--box-fade);
	}

	.socials a:hover {
		background-color: var(--dimmed-glow-color);
	}

	.socials a::before {
		padding-right: 1rem;
	}

	.ascii {
		font-family: monospace;
		font-synthesis-weight: none;
		font-variant-ligatures: none;
		line-height: 1;
		padding: 0;
		margin: 0;
		user-select: none;
	}
</style>
