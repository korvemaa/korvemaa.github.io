---
import Layout from "@layout/Layout.astro";
import ScrollView from "@component/ScrollView.astro";
import Figlet from "@component/Figlet.astro";
import Divider from "@component/Divider.astro";
import AsciiArt from "@component/AsciiArt.astro";

export const explorer = {
	name: "HOME.md",
	order: 0,
};
---

<Layout>
	<ScrollView style="scroll-behavior:smooth;">
		<div class="hero">
			<div class="hero-content">
				<div id="name-ascii">
					<Figlet class="ascii scramble" text="Jake" font="Future" />
					<Figlet
						class="ascii scramble"
						text="Korvemaa"
						font="Future"
					/>
				</div>
				<span id="blurb">
					Sydney based senior software engineer with 5+ years of
					expertise. Specializing in creating value and unique experiences.
				</span>
				<hr />
				<div class="cta-stack">
					<a href="#experience">{"Professional experience"}</a>
					<a href="#about">{"Learn about me"}</a>
					<a href="#projects">{"Personal projects"}</a>
					<a href="#interests">{"Explore interests"}</a>
				</div>
			</div>
			<AsciiArt
				class="ascii ascii-background scramble vertical-mask"
				filePath="ascii/aura.txt"
			/>
		</div>
		<section id="about">
			<hr />
			<Divider title="> neofetch" />
			<div class="about">
				<div class="about-content">
					<div>
						<AsciiArt
							class="ascii scramble"
							filePath="ascii/bug-cat.txt"
						/>
					</div>
					<div style="gap: 0;">
						<span>jake@korvemaa.dev</span>
						<span>------------------------------</span>
						<span>Role: Senior Software Engineer</span>
						<span>Location: Sydney, AU</span>
						<span>Uptime: 5+ years</span>
						<span>Employment: Enviz</span>
					</div>
				</div>
				<hr />
				<div class="about-content">
					<div>
						<h1>Profile</h1>
						<p>
							Game developer and software engineer building
							gameplay systems, developer tools, and cloud-based
							applications. Experienced in Unity, C#, Azure,
							Blender, and multiplayer development. I like solving
							complex problems through thoughtful design.
						</p>
					</div>
					<div>
						<h1>Persona</h1>
						<p>
							Outside of work, you'll usually find me riding my
							motorcycle, working on personal projects, racing, or
							enjoying games and music. I'm always exploring
							something new, whether that's technology, hardware,
							or a new hobby.
						</p>
					</div>
				</div>
			</div>
		</section>
		<section id="experience">
			<hr />
			<Divider title="> Experience" />
			My professional experience goes here
		</section>
		<section id="projects">
			<hr />
			<Divider title="> Projects" />
			My featured projects will go here
		</section>
		<section id="interests">
			<hr />
			<Divider title="> Interests" />
			All motorsport and other related things go here
		</section>
	</ScrollView>
</Layout>

<script defer>
	const align = function () {
		document.body.style.setProperty(
			"--hero-height",
			document.getElementById("scroll-view").clientHeight + "px",
		);
	};

	window.addEventListener("resize", align);
	align();
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		margin: 1rem;
		gap: 1rem;
	}

	.hero {
		display: flex;
		flex-direction: column;
		min-height: var(--hero-height);
		max-height: var(--hero-height);

		position: relative;
		overflow: hidden;
		align-items: flex-start;
		justify-content: center;
		padding: 1rem 3rem;

		gap: 2rem;
	}

	section {
		display: flex;
		flex-direction: column;
		/* min-height: var(--hero-height); */
		flex-shrink: 0;
		padding: 1rem;
		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: stretch;
		gap: 1rem;
		max-width: 530px;
	}

	.hero #blurb {
		overflow-wrap: break-word;
		min-width: 0;
	}

	.hero .cta-stack {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.hero .cta-stack a {
		text-decoration: none;
		padding: 4px 1ch;
	}

	.hero .cta-stack a::after {
		content: " >";
		margin-left: 0.5ch;
	}

	.hero .cta-stack a:hover {
		background-color: var(--dimmed-glow-color);
	}

	.hero #name-ascii {
		display: flex;
		flex-wrap: wrap;
		flex-direction: row;
		gap: 1rem;
	}

	.about {
		display: flex;
		flex-grow: 1;
		flex-direction: column;

		align-items: stretch;
		justify-content: center;
		gap: 1rem;

		padding: 2rem;
	}

	.about .ascii {
		opacity: 1;
		font-family: Terminus;
	}

	.about-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;

		align-items: flex-start;
		justify-content: flex-start;
	}

	.about-content > :nth-child(odd) {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: flex-end;
		text-align: right;
		gap: 1rem;
	}

	.about-content > :nth-child(even) {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: flex-start;
		text-align: left;
		gap: 1rem;
	}

	.about-image {
	}

	.technical {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.technical code {
		font-size: 12px;
	}

	.socials {
		display: flex;
		flex-direction: column;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.socials a {
		padding: 0.5rem 1rem;
		border: var(--border-width) dotted var(--dimmed-glow-color);
		display: flex;
		flex-grow: 1;
		justify-content: center;
		text-decoration: none;
		align-items: center;
		background: var(--box-fade);
	}

	.socials a:hover {
		background-color: var(--dimmed-glow-color);
	}

	.socials a::before {
		padding-right: 1rem;
	}

	.ascii {
		font-family: monospace;
		font-synthesis-weight: none;
		font-variant-ligatures: none;
		line-height: 1;
		padding: 0;
		margin: 0;
		pointer-events: none;
		user-select: none;
	}

	.ascii-background {
		position: absolute;
		/* opacity: 0.075; */
		opacity: 0.15;
		font-family: Terminus;
		font-size: 18px;
	}

	.vertical-mask {
		mask-image: linear-gradient(black 20%, transparent 80%);
	}
</style>
