---
import { SOCIALS, SKILLS } from "@src/consts";
import Layout from "@layout/Layout.astro";
import ScrollView from "@component/ScrollView.astro";
import figlet from "figlet";

const font = "Future";
const firstName = figlet.textSync("Jake", { font });
const lastName = figlet.textSync("Korvemaa", { font });

export const explorer = {
	name: "WELCOME.md",
	order: 0,
};
---

<Layout fileName={explorer.name}>
	<ScrollView style="scroll-behavior:smooth;">
		<div class="hero">
			<div class="hero-content">
				<div class="hero-left">
					<div id="name-ascii">
						<pre class="ascii">{firstName}</pre>
						<pre class="ascii">{lastName}</pre>
					</div>
					<div class="socials">
						{
							SOCIALS.map((social) => (
								<a
									target="_blank"
									href={social.url}
									class={"icon bi bi-" + social.icon}
								>
									{social.title}
								</a>
							))
						}
					</div>
				</div>
				<div class="hero-right">
					<span id="blurb">
						Sydney based senior software engineer with 5+ years of
						experience working at
						<a href="/projects/enviz" id="cta">Enviz</a>.
					</span>
					<a href="#content" id="cta">Learn more about me > </a>
				</div>
			</div>
			<pre
				id="ascii-background"
				class="ascii"> 
