---
import { getCollection } from "astro:content";

import Layout from "@layout/Layout.astro";
import ScrollView from "@component/ScrollView.astro";
import Figlet from "@component/Figlet.astro";
import AsciiArt from "@component/AsciiArt.astro";
import ProjectTile from "@component/ProjectTile.astro";
import FloatingText from "@component/FloatingText.astro";

import { FLOATING_KEYWORDS } from "@src/consts";

const projects = (await getCollection("project"))
	.filter((e) => e.data.group === "Personal")
	.sort((a, b) => {
		const da = a.data.date?.getTime() ?? 100;
		const db = b.data.date?.getTime() ?? 100;
		return db - da;
	});

export const explorer = {
	name: "HOME.md",
	order: 0,
};
---

<Layout>
	<ScrollView style="scroll-behavior:smooth;">
		<div class="hero">
			<div class="hero-content">
				<div id="name-ascii">
					<Figlet class="ascii scramble" text="Jake" font="Future" />
					<Figlet
						class="ascii scramble"
						text="Korvemaa"
						font="Future"
					/>
				</div>
				<span id="blurb">
					Sydney based senior software engineer with 5+ years of
					expertise. Specializing in creating value and unique
					experiences.
				</span>
				<hr />
				<div class="cta-stack">
					<a href="#experience">{"Professional experience"}</a>
					<a href="#about">{"Learn about me"}</a>
					<a href="#projects">{"Personal projects"}</a>
					<a href="#interests">{"Explore interests"}</a>
				</div>
			</div>
			<AsciiArt
				class="ascii ascii-background scramble vertical-mask"
				filePath="ascii/aura.txt"
			/>
		</div>
		<section id="about">
			<hr />
			<div class="about">
				<div class="about-content">
					<Figlet
						style="align-self: flex-start;"
						class="ascii scramble"
						text="About me"
						font="Future"
					/>
					<div>
						Game developer and software engineer building gameplay
						systems, developer tools, and cloud-based applications.
						Experienced in Unity, C#, Azure, Blender, and
						multiplayer development. I like solving complex problems
						through thoughtful design.
					</div>
					<hr />
					<div>
						Outside of work, you'll usually find me riding my
						motorcycle, working on personal projects, racing, or
						enjoying games and music. I'm always exploring something
						new, whether that's technology, hardware, or a new
						hobby.
					</div>
				</div>
			</div>
			<div class="floating-text vertical-mask">
				<FloatingText strings={FLOATING_KEYWORDS} />
			</div>
			<AsciiArt
				class="ascii ascii-background scramble vertical-mask"
				filePath="ascii/about.txt"
			/>
		</section>
		<section id="experience">
			<hr />
			<h1>[ professional experience ]</h1>
		</section>
		<section id="projects">
			<hr />
			<h1>[ personal projects ]</h1>
			<div class="content-section">
				<div class="grid">
					{
						projects.map((post, index) => {
							return (
								<a
									style="display: flex; flex-grow: 1;"
									href={`/projects/${post.id}`}
								>
									<ProjectTile project={post} />
								</a>
							);
						})
					}
				</div>
			</div>
		</section>
		<section id="interests">
			<hr />
			<h1>[ explore interests ]</h1>
		</section>
	</ScrollView>
</Layout>

<script defer>
	const align = function () {
		document.body.style.setProperty(
			"--hero-height",
			document.getElementById("scroll-view").clientHeight + "px",
		);
	};

	window.addEventListener("resize", align);
	align();
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		margin: 1rem;
		gap: 1rem;
	}

	.hero {
		display: flex;
		flex-direction: column;
		min-height: var(--hero-height);
		max-height: var(--hero-height);

		position: relative;
		overflow: hidden;
		align-items: flex-start;
		justify-content: center;
		padding: 1rem 3rem;

		gap: 2rem;
	}

	section {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		padding: 1rem 1rem;
		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

	.content-section {
		display: flex;
		flex-direction: column;

		background-image: var(--box-fade);
		border: var(--border-width) dotted var(--dimmed-glow-color);
		padding: 1rem;
		gap: 1rem;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: stretch;
		gap: 1rem;
		max-width: 530px;
	}

	.hero #blurb {
		overflow-wrap: break-word;
		min-width: 0;
	}

	.hero .cta-stack {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.hero .cta-stack a {
		text-decoration: none;
		padding: 4px 1ch;
	}

	.hero .cta-stack a::after {
		content: " >";
		margin-left: 0.5ch;
	}

	.hero .cta-stack a:hover {
		background-color: var(--dimmed-glow-color);
	}

	.hero #name-ascii {
		display: flex;
		flex-wrap: wrap;
		flex-direction: row;
		gap: 1rem;
	}

	section#about {
		min-height: var(--hero-height);
		max-height: var(--hero-height);
	}

	section#about .floating-text {
		position: absolute;
		display: flex;
		flex-grow: 1;
		user-select: none;
		pointer-events: none;

		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
	}

	.about {
		display: flex;
		flex-grow: 1;
		flex-direction: column;

		align-items: flex-end;
		justify-content: center;

		padding: 1rem 2rem;
		gap: 2rem;
	}

	.about-content {
		display: flex;
		flex-direction: column;
		max-width: 570px;

		gap: 2rem;
		align-items: stretch;
		justify-content: flex-end;
	}

	.technical {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.technical code {
		font-size: 12px;
	}

	.socials {
		display: flex;
		flex-direction: column;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.socials a {
		padding: 0.5rem 1rem;
		border: var(--border-width) dotted var(--dimmed-glow-color);
		display: flex;
		flex-grow: 1;
		justify-content: center;
		text-decoration: none;
		align-items: center;
		background: var(--box-fade);
	}

	.socials a:hover {
		background-color: var(--dimmed-glow-color);
	}

	.socials a::before {
		padding-right: 1rem;
	}

	section .grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
		gap: 1rem;
	}

	section .wide-grid {
		grid-template-columns: repeat(auto-fill, minmax(min(350px, 100%), 1fr));
	}

	section .grid a {
		text-decoration: none;
	}

	.ascii {
		font-family: Terminus;
		font-synthesis-weight: none;
		font-variant-ligatures: none;
		line-height: 1;
		padding: 0;
		margin: 0;
		pointer-events: none;
		user-select: none;
	}

	.ascii-background {
		position: absolute;
		opacity: 0.2;
		font-family: Terminus;
		font-size: 18px;
	}

	#about .ascii-background {
		top: 1rem;
		right: 250px;
	}

	.vertical-mask {
		display: flex;
		align-items: stretch;
		mask-image: linear-gradient(black 20%, transparent 80%);
	}
</style>
