---
import { type CollectionEntry, getCollection } from "astro:content";
import path from 'path';

import UseME from "../404.astro"

export const explorer = {
    folder: "motorsport",
    children: (await getCollection("project"))
        .filter((e) => e.data.group == "Motorsport")
        .sort((a, b) => {
            const da = a.data.date?.getTime() ?? 100;
            const db = b.data.date?.getTime() ?? 100;
            return db - da;
        })
        .map((project) => ({
            name: project.data.fileName || path.basename(project.filePath!),
            url: "projects/" + project.id,
        })),
};
---

<UseME/>