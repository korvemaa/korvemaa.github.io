---
import { type CollectionEntry, getCollection } from "astro:content";
import path from 'path';

import fallback from "../404.astro"

export const explorer = {
    folder: "projects",
    order: -1,
    children: ((await getCollection("project")).filter(e=>e.data.group == "Personal").map((project)=>({
        name: project.data.fileName || project.data.title,
        url: "projects/" + project.id,
    })))
};
