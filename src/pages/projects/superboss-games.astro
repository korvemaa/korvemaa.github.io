---
import { getCollection, getEntry } from "astro:content";
import Layout from "@layout/Layout.astro";
import ScrollView from "@component/ScrollView.astro";
import ProjectBlock from "@component/project/ProjectBlock.astro";
import ProjectTile from "@component/ProjectTile.astro";
import Figlet from "@component/Figlet.astro";
import AsciiArt from "@component/AsciiArt.astro";

const projects = (await getCollection("project"))
	.filter((e) => e.id.startsWith("superboss-games"))
	.sort((a, b) => {
		const da = a.data.date?.getTime() ?? 100;
		const db = b.data.date?.getTime() ?? 100;
		return db - da;
	});

const maps = projects.filter((e) => e.data.group.endsWith("Map"));

const panther = await getEntry("project", "superboss-games/panther");
const manta = await getEntry("project", "superboss-games/manta");
const falcon = await getEntry("project", "superboss-games/falcon");
---

<Layout
	title="Superboss Games"
	routes={[{ name: "Superboss Games", href: "/projects/superboss-games" }]}
>
	<ScrollView style="scroll-behavior:smooth;">
		<div class="hero">
			<div class="banner"></div>
			<div class="hero-content">
				<span id="blurb" style="opacity: 0.5"> [ 2020 - 2021 ] </span>
				<div id="name-ascii">
					<Figlet
						class="ascii scramble"
						text="Superboss"
						font="Future"
					/>
					<Figlet class="ascii scramble" text="Games" font="Future" />
				</div>
				<span id="blurb"> Technical Artist working on "Intruder" </span>
			</div>
		</div>

		<section id="what-is">
			<h1 class="faded-title">[ what is intruder ]</h1>
			<div class="content">
				<div class="block">
					<div>
						<h1>Inspiration</h1>
						<hr />
						<p>
							Intruder is the stealth multiplayer experience. We
							were inspired by the great single-player campaigns
							of Metal Gear Solid, SWAT3, Deus Ex, and Splinter
							Cell to create a team-based multiplayer game.
							Intruder allows for stealth, teamwork, tactics and
							environmental interactions never before seen in a
							multiplayer game.
						</p>
					</div>
					<iframe
						class="youtube"
						src=`https://www.youtube.com/embed/peCgGt7N-84`
						allowfullscreen></iframe>
				</div>
				<div class="block">
					<div>
						<h1>Gameplay</h1>
						<hr />
						<p>
							Lure enemies into motion-detectors near explosive
							traps. Watch enemy movement through live security
							cameras and alert your teammates using the hand
							radio. Use real SWAT hand signals to communicate
							silently when enemies are nearby. In Intruder,
							amazing stories and emergent gameplay come from the
							players' actions to provide an experience you will
							never forget.
						</p>
					</div>
					<iframe
						class="youtube"
						src=`https://www.youtube.com/embed/hLJy1IBNfHs`
						allowfullscreen></iframe>
				</div>
			</div>
		</section>

		<section id="weapons">
			<h1 class="faded-title">[ weapons textured ]</h1>
			<div id="project">
				<Figlet font="Future" text="Manta" class="ascii scramble"/>
				<ProjectBlock project={manta} />
				<AsciiArt
					class="ascii ascii-background terminus scramble vertical-mask"
					filePath="ascii/manta.txt"
				/>
			</div>

			<hr />

			<div id="project">
				<Figlet font="Future" text="Falcon" class="ascii scramble"/>
				<ProjectBlock project={falcon} />
				<AsciiArt
					class="ascii ascii-background terminus scramble vertical-mask"
					filePath="ascii/falcon.txt"
				/>
			</div>

			<hr />

			<div id="project">
				<Figlet font="Future" text="Panther" class="ascii scramble"/>
				<ProjectBlock project={panther} />
				<AsciiArt
					class="ascii ascii-background terminus scramble vertical-mask"
					filePath="ascii/panther.txt"
				/>
			</div>
		</section>

		<section id="other">
			<h1 class="faded-title">[ other content ]</h1>
			<div class="grid">
				{
					maps.map((post) => {
						return (
							<a
								data-group={post.data.group}
								href={`/projects/${post.id}`}
							>
								<ProjectTile project={post} />
							</a>
						);
					})
				}
			</div>
		</section>
	</ScrollView>
</Layout>

<script defer>
	const align = function () {
		document.body.style.setProperty(
			"--hero-height",
			document.getElementById("scroll-view").clientHeight + "px",
		);
	};

	window.addEventListener("resize", align);
	align();
</script>

<style>
	div#weapons hr {
		margin: 4rem;
	}

	.hero {
		display: flex;
		flex-direction: column;
		min-height: calc(var(--hero-height) * 0.55);

		position: relative;
		overflow: hidden;
		align-items: center;
		justify-content: center;
		padding: 1rem 3rem;

		gap: 2rem;
	}

	.hero .banner {
		background-image: url("/intruder-screenshot.jpg");
		pointer-events: none;
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		right: 0;
		background-repeat: no-repeat;
		background-size: cover;
		opacity: 0.3;
		mask-image: linear-gradient(to bottom, black 0%, transparent 100%);

		z-index: -10;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		gap: 1rem;
		max-width: 530px;
	}

	.hero #blurb {
		overflow-wrap: break-word;
		min-width: 0;
	}

	.hero .cta-stack {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.hero .cta-stack a {
		text-decoration: none;
		padding: 4px 1ch;
	}

	.hero .cta-stack a::after {
		content: " >";
		margin-left: 0.5ch;
	}

	.hero .cta-stack a:hover {
		background-color: var(--dimmed-glow-color);
		cursor: pointer;
	}

	.hero #name-ascii {
		display: flex;
		flex-wrap: wrap;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.faded-title {
		opacity: 0.5;
		align-self: center;
	}

	:global(.ascii) {
		font-family: monospace;
		font-synthesis: none;
		font-variant-ligatures: none;
		line-height: 1;
		padding: 0;
		margin: 0;
		pointer-events: none;
		user-select: none;
	}

	:global(.ascii-background) {
		position: absolute;
		opacity: 0.07;
		font-family: monospace;
		font-size: 16px;
	}

	.terminus {
		/* FOR SOME REASON CHROMIUM RENDERS TERMINUS FUCKING STUPIDLY I HATE CHROME POS, so terminus is only used for background ascii */
		font-family: Terminus;
		font-synthesis: none;
		font-variant-ligatures: none;
	}

	.vertical-mask {
		display: flex;
		align-items: stretch;
		mask-image: linear-gradient(black 50%, transparent 90%);
	}

	section {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		padding: 2rem 1rem;

		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

	/* What is intruder */

	section#what-is {
		min-height: calc(var(--hero-height) * 0.8);
		gap: 0;
	}

	section#what-is .content {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		justify-content: center;
	}

	section#what-is .block {
		display: flex;

		align-items: center;
		justify-content: center;
		text-align: right;

		padding: 3rem;
		gap: 3rem;
	}

	section#what-is .block:nth-child(even) {
		flex-direction: row-reverse;
		text-align: left;
	}

	section#what-is .block > div {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	section#what-is .block p {
		margin: 0;
		padding: 0;
		max-width: 650px;
	}

	section#what-is .block iframe {
		border: var(--border-width) dotted var(--dimmed-glow-color);
		aspect-ratio: 16/9;
		height: 250px;
	}

	div#project {
		min-height: calc(var(--hero-height) * 0.55);
		padding: 0;
		align-items: center;
		justify-content: center;
	}

	div#project .vertical-mask {
		mask-image: linear-gradient(
			transparent 5%,
			black 25%,
			black 75%,
			transparent 95%
		);
	}

	section a {
		text-decoration: none;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
		gap: 0.5rem;
	}

	.videos {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(400px, 100%), 1fr));
		gap: 1rem;
	}

	.videos .youtube {
		display: inline-flex;
		aspect-ratio: 16/9;
		flex-grow: 1;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
