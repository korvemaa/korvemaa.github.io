---
import { getCollection, getEntry  } from "astro:content";
import Layout from "@layout/Layout.astro";
import ScrollView from "@component/ScrollView.astro";
import ProjectBlock from "@component/project/ProjectBlock.astro"
import ProjectTile from "@component/ProjectTile.astro";
import Figlet from "@component/Figlet.astro";
import AsciiArt from "@component/AsciiArt.astro";

const projects = (await getCollection("project"))
    .filter((e) => e.id.startsWith("superboss-games"))
    .sort((a, b) => {
        const da = a.data.date?.getTime() ?? 100;
        const db = b.data.date?.getTime() ?? 100;
        return db - da;
    });

const weapons = projects.filter((e) => e.data.group.endsWith("Weapon"));
const maps = projects.filter((e) => e.data.group.endsWith("Map"));
const videos = ["peCgGt7N-84", "hLJy1IBNfHs"];

const panther = await getEntry("project", "superboss-games/panther");
const manta = await getEntry("project", "superboss-games/manta");
const falcon = await getEntry("project", "superboss-games/falcon");
---

<Layout title="Superboss Games" routes={[{name: "Superboss Games", href:"/projects/superboss-games"}]}>
	<ScrollView style="scroll-behavior:smooth;">
		<div class="hero">
			<div class="hero-content">
				<span id="blurb" style="opacity: 0.5">
                    [ 2020 - 2021 ]
				</span>
				<div id="name-ascii">
					<Figlet 
                        class="ascii scramble"
                        text="Superboss"
                        font="Future" 
                    />
					<Figlet
						class="ascii scramble"
						text="Games"
						font="Future"
					/>
				</div>
				<span id="blurb">
                    Technical Artist working on "Intruder"
				</span>
			</div>
			<AsciiArt
				class="ascii ascii-background terminus scramble vertical-mask"
				filePath="ascii/panther.txt"
			/>
		</div>

        <section id="projects">
            <h1>Videos</h1>
            <hr />
            <div class="videos">
                {
                    videos.map((e) => (
                        <iframe
                            class="youtube"
                            src=`https://www.youtube.com/embed/${e}`
                            allowfullscreen
                        />
                    ))
                }
            </div>
        </section>

		<section id="weapons">
			<div id="project">
				Manta
				<ProjectBlock project={manta}/>
				<AsciiArt
					class="ascii ascii-background terminus scramble vertical-mask"
					filePath="ascii/manta.txt"
				/>
			</div>

			<hr/>

			<div id="project">
				Falcon
				<ProjectBlock project={falcon}/>
				<AsciiArt
					class="ascii ascii-background terminus scramble vertical-mask"
					filePath="ascii/falcon.txt"
				/>
			</div>

			<hr/>

			<div id="project">
				Panther
				<ProjectBlock project={panther}/>
				<AsciiArt
					class="ascii ascii-background terminus scramble vertical-mask"
					filePath="ascii/panther.txt"
				/>
			</div>
		</section>

        <section id="other">
            <h1>Other</h1>
            <hr />
            Assortment of minor projects official or not for Intruder
            <div class="grid">
                {
                    maps.map((post) => {
                        return (
                            <a
                                data-group={post.data.group}
                                href={`/projects/${post.id}`}
                            >
                                <ProjectTile project={post}/>
                            </a>
                        );
                    })
                }
            </div>
        </section>
    </ScrollView>
</Layout>

<script defer>
	const align = function () {
		document.body.style.setProperty(
			"--hero-height",
			document.getElementById("scroll-view").clientHeight + "px",
		);
	};

	window.addEventListener("resize", align);
	align();
</script>

<style>
	div#weapons hr {
		margin: 4rem;
	}
	
	.hero {
		display: flex;
		flex-direction: column;
		min-height: calc(var(--hero-height) * 0.5);
		max-height: cal(var(--hero-height) * 0.5);

		position: relative;
		overflow: hidden;
		align-items: center;
		justify-content: center;
		padding: 1rem 3rem;

		gap: 2rem;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		gap: 1rem;
		max-width: 530px;
	}

	.hero #blurb {
		overflow-wrap: break-word;
		min-width: 0;
	}

	.hero .cta-stack {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.hero .cta-stack a {
		text-decoration: none;
		padding: 4px 1ch;
	}

	.hero .cta-stack a::after {
		content: " >";
		margin-left: 0.5ch;
	}

	.hero .cta-stack a:hover {
		background-color: var(--dimmed-glow-color);
		cursor: pointer;
	}

	.hero #name-ascii {
		display: flex;
		flex-wrap: wrap;
		flex-direction: row;
        align-items: center;
        justify-content: center;
		gap: 1rem;
	}

	.faded-title {
		opacity: 0.5;
		align-self: center;
	}

	:global(.ascii) {
		font-family: monospace;
		font-synthesis: none;
		font-variant-ligatures: none;
		line-height: 1;
		padding: 0;
		margin: 0;
		pointer-events: none;
		user-select: none;
	}

	:global(.ascii-background) {
		position: absolute;
		opacity: 0.07;
		font-family: monospace;
		font-size: 16px;
	}

	.terminus {
		/* FOR SOME REASON CHROMIUM RENDERS TERMINUS FUCKING STUPIDLY I HATE CHROME POS, so terminus is only used for background ascii */
		font-family: Terminus;
		font-synthesis: none;
		font-variant-ligatures: none;
	}

	.vertical-mask {
		display: flex;
		align-items: stretch;
		mask-image: linear-gradient(black 50%, transparent 90%);
	}

    .content {
        display: flex;
        flex-direction: column;
        padding: 1rem;
        gap: 1rem;
    }

	section {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		padding: 2rem 1rem;

		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

	div#project {
		min-height: calc(var(--hero-height) * 0.55);
		padding: 0;
		align-items: center;
		justify-content: center;
	}

	div#project .vertical-mask {
		mask-image: linear-gradient(transparent 5%, black 25%,  black 75%, transparent 95%);
	}

    section a {
        text-decoration: none;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
        gap: 0.5rem;
    }

    .videos {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(400px, 100%), 1fr));
        gap: 1rem;
    }

    .videos .youtube {
        display: inline-flex;
        aspect-ratio: 16/9;
        flex-grow: 1;
        width: 100%;
        height: 100%;
        border: 0;
    }
</style>
